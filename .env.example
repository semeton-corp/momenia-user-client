# Backend origin for the /api/v1 rewrite and direct OAuth-start requests.
# Use your deployed backend origin; this is intentionally not an invented local port.
NEXT_PUBLIC_API_URL=https://api.example.com

# Set both to true together so the promotion page, redirect middleware, and promo navbar agree.
NEXT_PUBLIC_PROMOTIONAL_PAGE=false
PROMOTIONAL_PAGE=false

# Opt-in features: enabled only when exactly true.
NEXT_PUBLIC_FEATURE_PAYMENT_ADDONS=false
NEXT_PUBLIC_FEATURE_MUSIC=false

# Testimonials stay enabled unless exactly false.
NEXT_PUBLIC_FEATURE_TESTIMONIALS=true
