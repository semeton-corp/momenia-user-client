{
    "name": "momenia-user-client",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-01-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "images": {
        "binding": "IMAGES"
    },
    "vars": {
        "NEXT_PUBLIC_API_URL": "https://api-staging.momenia.id",
        "PROMOTIONAL_PAGE": "false",
        "NEXT_PUBLIC_FEATURE_MUSIC": "true",
        "NEXT_PUBLIC_FEATURE_PAYMENT_ADDONS": "false"
    }
}